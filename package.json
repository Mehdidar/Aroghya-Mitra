{
  "name": "aroghya-mitra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aroghya Mitra: one Expo app for patients, ASHA workers and doctors/admins, with a TypeScript server and a Python food-recognition service.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:server && npm run test:app",
    "test:app": "npm test --workspace apps/mobile",
    "test:server": "node --test \"server/**/*.test.ts\" \"packages/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace apps/mobile",
    "lint": "npm run lint --workspace apps/mobile",
    "dev:server": "node server/scripts/devServer.ts",
    "demo": "node scripts/demo.mjs",
    "ml:test": "cd ml/food-classifier && python -m pytest -m \"not slow\" -q",
    "start": "npm run start --workspace apps/mobile",
    "demo:web": "node scripts/demo.mjs --web",
    "demo:server": "node scripts/demo.mjs --server-only",
    "db:check": "node server/scripts/dbCheck.ts",
    "db:seed": "node server/scripts/dbSeed.ts",
    "db:migrate": "node server/scripts/dbMigrate.ts",
    "review:clinical": "node scripts/clinical-review.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "@types/react": "~19.3.0"
  }
}
