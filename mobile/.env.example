# Copy to .env. Every value is optional: with nothing set the ASHA app runs fully offline with demo data.

# Backend that implements POST /asha/sync and POST /asha/photos (see features/asha/services/sync.ts)
EXPO_PUBLIC_API_URL=

# Sarvam speech-to-text. Prefer a backend proxy that adds the key server-side:
EXPO_PUBLIC_SARVAM_STT_URL=
# Hackathon-only fallback: direct call. This key ships inside the app bundle, so don't use it in production.
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_SARVAM_STT_MODEL=saarika:v2.5

# Seed demo households on first launch (1 = yes, 0 = no)
EXPO_PUBLIC_ASHA_DEMO=1

# Signed-in ASHA until P1's auth lands
EXPO_PUBLIC_ASHA_ID=asha-demo-1
EXPO_PUBLIC_ASHA_NAME=Sunita Devi

# P2's AI server (server/ai). The nutrition scan posts photos to {EXPO_PUBLIC_AI_URL}/ai/food.
# Unset or unreachable = labelled demo results. Phones: http://<laptop LAN IP>:<port>; web/simulator: http://localhost:<port>
EXPO_PUBLIC_AI_URL=

# Supabase (Phase B; phone OTP runs in demo mode with code 123456 until these are set and wired)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
