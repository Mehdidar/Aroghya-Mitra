# Server-side secrets (repo root). Never put these in an EXPO_PUBLIC_ variable: the app bundle is public.
SARVAM_API_KEY=            # speech-to-text, text-to-speech, chat (https://dashboard.sarvam.ai)
GEMINI_API_KEY=            # prescription and food photo reading (https://aistudio.google.com/app/apikey)
QR_TOKEN_SECRET=           # >= 32 random bytes; signs QR health-card tokens
DISHDETECT_URL=http://localhost:8000   # ml/food-classifier FastAPI service
# Real auth (optional; without these the server trusts x-demo-role, for laptop demos only)
SUPABASE_URL=
SUPABASE_JWT_SECRET=       # legacy HS256 projects; new projects are verified through SUPABASE_URL's JWKS
AUTH_MODE=                 # 'supabase' to force JWT checks, 'demo' to force the bypass
PORT=8787
