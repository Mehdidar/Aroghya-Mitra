# Copy to .env. Every value is optional: with nothing set the app runs fully offline with demo data.
# Never put an API key in an EXPO_PUBLIC_ variable: the app bundle is public. Keys go in the repo-root .env (server).

# The Aroghya Mitra server (npm run dev:server, port 8787): speech, chatbot, prescription reading,
# nutrition scan, ASHA sync, QR health card. Phones: http://<laptop LAN IP>:8787; web/simulator: http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
# Nutrition scan endpoint base (the server proxies /ai/food to the ML service); normally the same as API_URL
EXPO_PUBLIC_AI_URL=http://localhost:8787

# Supabase phone OTP (optional). Without these, sign-in uses demo codes (123456).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ASHA demo mode: seed demo households on first launch (1 = yes, 0 = no)
EXPO_PUBLIC_ASHA_DEMO=1
