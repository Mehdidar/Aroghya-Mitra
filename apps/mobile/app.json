{
  "expo": {
    "name": "Aroghya Mitra",
    "slug": "aroghya-mitra",
    "scheme": "aroghyamitra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the hospital entrance QR code to set your starting point."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Record where a field visit took place."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Attach photos to a field visit.",
          "photosPermission": "Choose a photo of your food or a report."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record a voice report of your visit."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0FAFA"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#0E9F9A"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Aroghya Mitra counts your steps to show your daily activity."
        }
      ]
    ],
    "android": {
      "package": "com.aroghyamitra.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E9F9A"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.aroghyamitra.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
