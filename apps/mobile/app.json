{
  "expo": {
    "name": "Aroghya Mitra",
    "slug": "aroghya-mitra",
    "scheme": "aroghyamitra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the hospital entrance QR code to set your starting point."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Record where a field visit took place."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Attach photos to a field visit.",
          "photosPermission": "Choose a photo of your food or a report."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record a voice report of your visit."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0FAFA"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Aroghya Mitra counts your steps to show your daily activity."
        }
      ]
    ],
    "android": {
      "package": "com.aroghyamitra.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E9F9A"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.aroghyamitra.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "edf74594-5371-49bf-8322-aeb4ee0b7138"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true
    },
    "owner": "mehdi_dar",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/edf74594-5371-49bf-8322-aeb4ee0b7138"
    }
  }
}
