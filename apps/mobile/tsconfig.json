{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@am/shared": [
        "../../packages/shared/index.ts"
      ],
      "@am/shared/*": [
        "../../packages/shared/*"
      ],
      "@am/patient-ai": [
        "../../packages/patient-ai/index.ts"
      ],
      "@am/patient-ai/*": [
        "../../packages/patient-ai/*"
      ],
      "@am/records": [
        "../../packages/records/index.ts"
      ],
      "@am/records/*": [
        "../../packages/records/*"
      ],
      "@server/*": [
        "../../server/*"
      ]
    },
    "types": [
      "jest"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-*",
    "../../node_modules",
    "../../packages/**/*.test.ts",
    "../../packages/**/__tests__/**",
    "../../server/**/*.test.ts",
    "../../server/**/__tests__/**",
    "../../server/**/scripts/**"
  ]
}
